{
  "firestore": {
    "collections": {
      "users": {
        "description": "Stores user profile information and links to their content.",
        "fields": {
          "username": { "type": "string", "description": "Unique user handle." },
          "displayName": { "type": "string", "description": "User's display name." },
          "email": { "type": "string", "description": "User's email for authentication." },
          "avatarUrl": { "type": "string", "description": "URL for the user's profile picture." },
          "bio": { "type": "string", "description": "User's public biography." },
          "role": { "type": "string", "description": "Role of the user, e.g., 'reader' or 'writer'." },
          "followersCount": { "type": "number", "description": "Total number of followers." },
          "followingCount": { "type": "number", "description": "Total number of users they follow." },
          "followingIds": { "type": "array", "description": "An array of user IDs that this user follows." },
          "readingList": { "type": "array", "description": "Array of story objects the user has saved." },
          "achievements": { "type": "array", "description": "Array of achievement objects the user has unlocked." },
          "createdAt": { "type": "timestamp", "description": "When the user account was created." },
          "updatedAt": { "type": "timestamp", "description": "When the user profile was last updated." },
          "isAnonymous": { "type": "boolean", "description": "Flag for guest users." }
        }
      },
      "stories": {
        "description": "The core collection for all stories created by users.",
        "fields": {
          "author": { "type": "map", "description": "Summary object of the story's author.", "reference": "users" },
          "title": { "type": "string", "description": "Title of the story." },
          "summary": { "type": "string", "description": "A short description or blurb for the story." },
          "genre": { "type": "string", "description": "The primary genre of the story." },
          "status": { "type": "string", "description": "Current status: 'Draft', 'Ongoing', 'Completed'." },
          "visibility": { "type": "string", "description": "Access level: 'Public', 'Unlisted', 'Private'." },
          "coverImageUrl": { "type": "string", "description": "URL for the story's cover image." },
          "lastUpdated": { "type": "timestamp", "description": "Timestamp of the last update." },
          "views": { "type": "number", "description": "Total views." }
        },
        "subcollections": {
          "chapters": {
            "description": "Individual chapters for each story.",
            "fields": {
              "id": { "type": "string", "description": "Unique ID." },
              "title": { "type": "string", "description": "Title." },
              "content": { "type": "string", "description": "Text content." },
              "order": { "type": "number", "description": "Numerical order." },
              "status": { "type": "string", "description": "'Published' or 'Draft'." }
            }
          }
        }
      },
      "statusUpdates": {
        "description": "Temporary 24-hour status updates.",
        "fields": {
          "authorId": { "type": "string", "description": "Author ID." },
          "status": { "type": "string", "description": "'published' or 'draft'." },
          "visibility": { "type": "string", "description": "'public' or 'close-friends'." },
          "createdAt": { "type": "timestamp", "description": "Creation time." },
          "expiresAt": { "type": "timestamp", "description": "Expiration time." }
        }
      },
      "broadcasts": {
        "description": "Official transmissions from the platform owner.",
        "fields": {
          "author": { "type": "map", "description": "Owner summary." },
          "content": { "type": "string", "description": "Message content." },
          "category": { "type": "string", "description": "Log category." },
          "timestamp": { "type": "timestamp", "description": "Transmission time." }
        }
      },
      "featuredCarousel": {
        "description": "Slides for the homepage featured stories hub.",
        "fields": {
          "title": { "type": "string", "description": "Slide title." },
          "imageUrl": { "type": "string", "description": "Background image." },
          "ctaLink": { "type": "string", "description": "Target destination." },
          "isActive": { "type": "boolean", "description": "Live status." }
        }
      },
      "notifications": {
        "description": "User activity alerts.",
        "fields": {
          "userId": { "type": "string", "description": "Recipient ID." },
          "actor": { "type": "map", "description": "Trigger user summary." },
          "type": { "type": "string", "description": "Alert type." },
          "isRead": { "type": "boolean", "description": "Read status." }
        }
      }
    }
  }
}