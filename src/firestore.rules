rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Unified Owner Check - Relying on UIDs for absolute security integrity.
    function isAppOwner() {
        return isSignedIn() && request.auth.uid in [
          'rpTmIq5pnKc91aSSgMJiF26zIYy2', // arnv
          'system_admin_id'
        ];
    }

    // --- Collection Rules ---

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      
      allow create: if isSignedIn() && isOwner(userId);

      // Allow users to update their own profile OR allow community members to increment followersCount
      // and followingIds for real-time community syncing.
      allow update: if isAppOwner()
                    || (isSignedIn() && isOwner(userId))
                    || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasAny(['followersCount', 'followingIds', 'closeFriendIds']));

      allow delete: if isAppOwner();
    }

    // Stories Collection
    match /stories/{storyId} {
      allow read: if resource.data.visibility == 'Public' 
                    || resource.data.visibility == 'Unlisted'
                    || (isSignedIn() && (request.auth.uid == resource.data.author.id || request.auth.uid in resource.data.collaboratorIds || isAppOwner()));

      allow create: if isSignedIn();
      
      allow update: if (isSignedIn() && (request.auth.uid == resource.data.author.id || request.auth.uid in resource.data.collaboratorIds || isAppOwner()))
                    || (
                      (resource.data.visibility == 'Public' || resource.data.visibility == 'Unlisted')
                      && request.resource.data.diff(resource.data).affectedKeys().hasAny(['views', 'chapters'])
                    );

      allow delete: if isSignedIn() && (request.auth.uid == resource.data.author.id || isAppOwner());
    }

    // Carousel Collection
    match /featuredCarousel/{slideId} {
      allow read: if true;
      allow write: if isAppOwner();
    }

    // Broadcasts Collection
    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow create, delete: if isAppOwner();
      allow update: if isSignedIn();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && (isOwner(resource.data.user.id) || isAppOwner());
      }

      match /reactions/{userId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn() && (isOwner(userId) || isAppOwner());
      }
    }

    // Comments Collection
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (isOwner(resource.data.user.id) || isAppOwner());
    }
    
    // Notifications Collection (Critical Signal Hub)
    match /notifications/{notificationId} {
      allow read, list, update, delete: if isSignedIn() && isOwner(resource.data.userId);
      
      // Allow any signed-in user to send community signals (Follows, Likes, Reposts, Mentions)
      allow create: if isSignedIn() && request.resource.data.keys().hasAll(['userId', 'type', 'actor']);
    }

    // Conversations & Messages
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        allow read, create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow update, delete: if false;
      }
    }
    
    // Status Updates
    match /statusUpdates/{statusId} {
      // Split get and list to authorize public feed vs private circle access
      allow get: if isAppOwner() 
                    || (isSignedIn() && isOwner(resource.data.authorId))
                    || (resource.data.status == 'published' && resource.data.isHidden == false);
      
      allow list: if isSignedIn() && (
        isAppOwner() || 
        (resource.data.status == 'published' && resource.data.isHidden == false && resource.data.visibility == 'public')
      );
      
      allow create: if isSignedIn() && isOwner(request.resource.data.authorId);
      allow update: if isSignedIn() && (
        isAppOwner() || 
        isOwner(resource.data.authorId) || 
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['reactionsCount', 'reactionCounts', 'repostsCount'])
      );
      allow delete: if isAppOwner() || (isSignedIn() && isOwner(resource.data.authorId));

      match /reactions/{userId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn() && (isOwner(userId) || isAppOwner());
      }
    }

    // Prompts
    match /prompts/{promptId} {
      allow read: if resource.data.isArchived == false;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (isOwner(resource.data.author.id) || isAppOwner());
    }
    
    // Letters
    match /letters/{letterId} {
       allow read: if isSignedIn() && (isOwner(resource.data.reader.id) || isOwner(resource.data.authorId) || isAppOwner());
       allow create: if isSignedIn();
       allow update: if isSignedIn() && (isOwner(resource.data.authorId) || isAppOwner());
       allow delete: if isSignedIn() && (isOwner(resource.data.reader.id) || isAppOwner());
    }

    // Annotations
    match /annotations/{annotationId} {
      allow read: if resource.data.visibility == 'public' || (isSignedIn() && (isOwner(resource.data.userId) || isAppOwner()));
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
      allow update, delete: if isSignedIn() && (isOwner(resource.data.userId) || isAppOwner());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && (isOwner(resource.data.user.id) || isAppOwner());
      }
    }

    // Community Feed Posts
    match /feedPosts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && isOwner(request.resource.data.author.id);
      allow update: if isSignedIn() && (
        isAppOwner() || isOwner(resource.data.author.id) || 
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['reactionsCount', 'reactionCounts', 'repostCount', 'commentsCount'])
      );
      allow delete: if isAppOwner() || isOwner(resource.data.author.id);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && (isOwner(resource.data.user.id) || isAppOwner());
      }
      
      match /reactions/{userId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn() && (isOwner(userId) || isAppOwner());
      }
    }
  }
}