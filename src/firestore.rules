rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Unified Owner Protocol: Fixed UID anchor for absolute archival integrity.
    function isAppOwner() {
        return isSignedIn() && request.auth.uid in [
          'rpTmIq5pnKc91aSSgMJiF26zIYy2', // arnv
          'system_admin_id'
        ];
    }

    // --- Core Identity & Stories ---

    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isAppOwner() || (isSignedIn() && isOwner(userId)) || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasAny(['followersCount', 'followingIds', 'closeFriendIds']));
      allow delete: if isAppOwner();
    }

    match /stories/{storyId} {
      allow read: if resource.data.visibility == 'Public' || resource.data.visibility == 'Unlisted' || (isSignedIn() && (request.auth.uid == resource.data.author.id || request.auth.uid in resource.data.collaboratorIds || isAppOwner()));
      allow create: if isSignedIn();
      allow update: if (isSignedIn() && (request.auth.uid == resource.data.author.id || request.auth.uid in resource.data.collaboratorIds || isAppOwner())) || ((resource.data.visibility == 'Public' || resource.data.visibility == 'Unlisted') && request.resource.data.diff(resource.data).affectedKeys().hasAny(['views', 'chapters', 'notes', 'rating']));
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.author.id || isAppOwner());
    }

    match /featuredCarousel/{slideId} {
      allow read: if true;
      allow write: if isAppOwner();
    }

    // --- Threads & Messaging Hub ---

    match /conversations/{threadId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAppOwner());
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;
      // Participants can update thread metadata (Archive, Ignore, Pin, Nicknames, Theme)
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAppOwner());
      allow delete: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAppOwner());

      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(threadId)).data.participantIds || isAppOwner());
        allow create: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(threadId)).data.participantIds || isAppOwner());
        // Participants can Edit, Unsend, or Delete for themselves
        allow update: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(threadId)).data.participantIds || isAppOwner());
        allow delete: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(threadId)).data.participantIds || isAppOwner());
      }
    }

    // --- Community Feed & Broadcasts ---

    match /broadcasts/{broadcastId} {
      allow read, list: if true;
      allow create, delete: if isAppOwner();
      allow update: if isSignedIn() && (isAppOwner() || request.resource.data.diff(resource.data).affectedKeys().hasAny(['reactionsCount', 'reactionCounts', 'commentsCount']));
    }

    match /feedPosts/{postId} {
      allow read, list: if true;
      allow create: if isSignedIn() && isOwner(request.resource.data.author.id);
      allow update: if isSignedIn() && (isAppOwner() || isOwner(resource.data.author.id) || request.resource.data.diff(resource.data).affectedKeys().hasAny(['reactionsCount', 'reactionCounts', 'repostCount', 'commentsCount']));
      allow delete: if isAppOwner() || isOwner(resource.data.author.id);
    }
    
    // --- Isolated Archival Nodes ---

    match /notifications/{notificationId} {
      allow read, list, update, delete: if isSignedIn() && (isOwner(resource.data.userId) || isAppOwner());
      allow create: if isSignedIn();
    }

    match /prompts/{promptId} {
      allow read, list: if resource.data.isArchived == false || isAppOwner();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (isOwner(resource.data.author.id) || isAppOwner());
    }

    match /letters/{letterId} {
      allow read, list: if isSignedIn() && (isOwner(resource.data.reader.id) || isOwner(resource.data.authorId) || isAppOwner());
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (isOwner(resource.data.authorId) || isAppOwner());
    }

    match /annotations/{annotationId} {
      allow read, list: if resource.data.visibility == 'public' || (isSignedIn() && (isOwner(resource.data.userId) || isAppOwner()));
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (isOwner(resource.data.userId) || isAppOwner());
    }

    match /statusUpdates/{statusId} {
      allow get: if isAppOwner() || (isSignedIn() && resource.data.authorId == request.auth.uid) || (resource.data.status == 'published' && resource.data.isHidden == false);
      allow list: if isAppOwner() || (request.query.filters.visibility == 'public');
      allow create: if isSignedIn() && isOwner(request.resource.data.authorId);
      allow update, delete: if isAppOwner() || (isSignedIn() && isOwner(resource.data.authorId));
    }

    match /questions/{questionId} {
      allow read, list: if resource.data.status == 'answered' || (isSignedIn() && (isOwner(resource.data.authorId) || isAppOwner()));
      allow create: if isSignedIn() && isOwner(request.resource.data.asker.id);
      allow update, delete: if isSignedIn() && (isOwner(resource.data.authorId) || isAppOwner());
    }

    match /polls/{pollId} {
      allow read, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isAppOwner() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['options']));
      allow delete: if isAppOwner() || (isSignedIn() && isOwner(resource.data.authorId));
    }
  }
}