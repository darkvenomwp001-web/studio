rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Unified Owner Check - Relying on UIDs for absolute security integrity.
    function isAppOwner() {
        return isSignedIn() && request.auth.uid in [
          'rpTmIq5pnKc91aSSgMJiF26zIYy2', // arnv
          'system_admin_id'
        ];
    }

    // --- Collection Rules ---

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      
      allow create: if isSignedIn() && isOwner(userId);

      allow update: if isAppOwner()
                    || (isSignedIn() && isOwner(userId))
                    || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasAny(['followersCount', 'followingIds', 'followingCount', 'closeFriendIds', 'appearanceSettings', 'readerSettings', 'privacySettings', 'fcmTokens', 'readingList']));

      allow delete: if isAppOwner();
    }

    // Stories Collection
    match /stories/{storyId} {
      allow read: if resource.data.visibility == 'Public' 
                    || resource.data.visibility == 'Unlisted'
                    || (isSignedIn() && (request.auth.uid == resource.data.author.id || request.auth.uid in resource.data.collaboratorIds || isAppOwner()));

      allow create: if isSignedIn();
      
      allow update: if (isSignedIn() && (request.auth.uid == resource.data.author.id || request.auth.uid in resource.data.collaboratorIds || isAppOwner()))
                    || (
                      (resource.data.visibility == 'Public' || resource.data.visibility == 'Unlisted')
                      && request.resource.data.diff(resource.data).affectedKeys().hasAny(['views', 'chapters', 'notes', 'rating'])
                    );

      allow delete: if isSignedIn() && (request.auth.uid == resource.data.author.id || isAppOwner());
    }

    // Carousel Collection
    match /featuredCarousel/{slideId} {
      allow read: if true;
      allow write: if isAppOwner();
    }

    // Broadcasts Collection
    match /broadcasts/{broadcastId} {
      allow read, list: if true;
      allow create, delete: if isAppOwner();
      allow update: if isSignedIn() && (isAppOwner() || request.resource.data.diff(resource.data).affectedKeys().hasAny(['reactionsCount', 'reactionCounts', 'commentsCount']));

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && (isOwner(resource.data.user.id) || isAppOwner());
      }

      match /reactions/{userId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn() && (isOwner(userId) || isAppOwner());
      }
    }

    // Announcements Collection
    match /announcements/{announcementId} {
      allow read, list: if true;
      allow create: if isSignedIn() && (isOwner(request.resource.data.author.id) || isAppOwner());
      allow update, delete: if isSignedIn() && (isOwner(request.resource.data.author.id) || isAppOwner());
    }

    // Comments Collection
    match /comments/{commentId} {
      allow read, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (isOwner(resource.data.user.id) || isAppOwner());
    }
    
    // Notifications Collection
    match /notifications/{notificationId} {
      allow read, list, update, delete: if isSignedIn() && (isOwner(resource.data.userId) || isAppOwner());
      allow create: if isSignedIn();
    }

    // Conversations & Messages (Threads Hub)
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAppOwner());
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAppOwner());
      allow delete: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAppOwner());

      match /messages/{messageId} {
        allow read, create: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds || isAppOwner());
        allow update: if isSignedIn() && (
          request.auth.uid == resource.data.senderId 
          || request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
        );
        allow delete: if isSignedIn() && (request.auth.uid == resource.data.senderId || isAppOwner());
      }
    }
    
    // Status Updates
    match /statusUpdates/{statusId} {
      allow get: if isAppOwner() 
                    || (isSignedIn() && resource.data.authorId == request.auth.uid)
                    || (resource.data.status == 'published' && resource.data.isHidden == false);
      
      allow list: if true;
      
      allow create: if isSignedIn() && isOwner(request.resource.data.authorId);
      
      allow update: if isSignedIn() && (
        isAppOwner() || 
        isOwner(resource.data.authorId) || 
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['reactionsCount', 'reactionCounts', 'repostsCount'])
      );
      
      allow delete: if isAppOwner() || (isSignedIn() && isOwner(resource.data.authorId));

      match /reactions/{userId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn() && (isOwner(userId) || isAppOwner());
      }
    }

    // Prompts
    match /prompts/{promptId} {
      allow read, list: if resource.data.isArchived == false || isAppOwner();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (isOwner(resource.data.author.id) || isAppOwner());
    }
    
    // Letters
    match /letters/{letterId} {
       allow read, list: if isSignedIn() && (isOwner(resource.data.reader.id) || isOwner(resource.data.authorId) || isAppOwner());
       allow create: if isSignedIn();
       allow update: if isSignedIn() && (isOwner(resource.data.authorId) || isAppOwner());
       allow delete: if isSignedIn() && (isOwner(resource.data.reader.id) || isAppOwner());
    }

    // Annotations
    match /annotations/{annotationId} {
      allow read, list: if resource.data.visibility == 'public' || (isSignedIn() && (isOwner(resource.data.userId) || isAppOwner()));
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
      allow update, delete: if isSignedIn() && (isOwner(resource.data.userId) || isAppOwner() || request.resource.data.diff(resource.data).affectedKeys().hasAny(['reactionsCount', 'reactionCounts', 'commentsCount']));

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && (isOwner(resource.data.user.id) || isAppOwner());
      }
      
      match /reactions/{userId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn() && (isOwner(userId) || isAppOwner());
      }
    }

    // Community Feed Posts
    match /feedPosts/{postId} {
      allow read, list: if true;
      allow create: if isSignedIn() && isOwner(request.resource.data.author.id);
      allow update: if isSignedIn() && (
        isAppOwner() || isOwner(request.resource.data.author.id) || 
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['reactionsCount', 'reactionCounts', 'repostCount', 'commentsCount'])
      );
      allow delete: if isAppOwner() || isOwner(request.resource.data.author.id);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && isOwner(request.resource.data.user.id);
        allow update, delete: if isSignedIn() && (isOwner(request.resource.data.user.id) || isAppOwner());
      }
      
      match /reactions/{userId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn() && (isOwner(userId) || isAppOwner());
      }
    }

    // Questions & Polls
    match /questions/{questionId} {
      allow read, list: if resource.data.status == 'answered' || (isSignedIn() && (isOwner(resource.data.authorId) || isOwner(resource.data.asker.id) || isAppOwner()));
      allow create: if isSignedIn() && isOwner(request.resource.data.asker.id);
      allow update, delete: if isSignedIn() && (isOwner(resource.data.authorId) || isAppOwner());
    }

    match /polls/{pollId} {
      allow read, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isAppOwner() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['options'])); 
      allow delete: if isAppOwner() || (isSignedIn() && isOwner(resource.data.authorId));
    }
  }
}