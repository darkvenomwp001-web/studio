{
  "entities": {
    "User": {
      "title": "User",
      "description": "Core identity and archival settings for a creator.",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "bio": { "type": "string" },
        "level": { "type": "number" },
        "xp": { "type": "number" },
        "achievements": { "type": "array" },
        "followingIds": { "type": "array" },
        "closeFriendIds": { "type": "array" },
        "blockedUserIds": { "type": "array" },
        "appearanceSettings": { "type": "object" },
        "readerSettings": { "type": "object" }
      }
    },
    "Thread": {
      "title": "Thread",
      "description": "A high-fidelity communication node between creators.",
      "type": "object",
      "properties": {
        "participantIds": { "type": "array" },
        "participantInfo": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastMessage": { "type": "object" },
        "themeColor": { "type": "string" },
        "nicknames": { "type": "object" },
        "mutedBy": { "type": "array" },
        "archivedBy": { "type": "array" },
        "ignoredBy": { "type": "array" },
        "pinnedBy": { "type": "array" }
      }
    },
    "Message": {
      "title": "Message",
      "description": "A discrete archival entry within a thread.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["text", "image", "video", "audio", "file", "music"] },
        "mediaUrl": { "type": "string" },
        "isDisappearing": { "type": "boolean" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "replyTo": { "type": "object" },
        "reactions": { "type": "object" },
        "isEdited": { "type": "boolean" },
        "deletedFor": { "type": "array" },
        "isPinned": { "type": "boolean" }
      }
    },
    "Question": {
      "title": "Question",
      "description": "An inquiry directed towards an author.",
      "type": "object",
      "properties": {
        "asker": { "type": "object" },
        "authorId": { "type": "string" },
        "questionText": { "type": "string" },
        "status": { "type": "string", "enum": ["unanswered", "answered"] },
        "answerText": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Poll": {
      "title": "Poll",
      "description": "An interactive voting node created by authors.",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "question": { "type": "string" },
        "options": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Archival nodes for creator identities."
    },
    "/stories/{storyId}": {
      "schema": "Story",
      "description": "Creative manuscripts."
    },
    "/conversations/{threadId}": {
      "schema": "Thread",
      "description": "Communication hubs."
    },
    "/conversations/{threadId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Individual message transmissions."
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Activity alerts."
    },
    "/prompts/{promptId}": {
      "schema": "Prompt",
      "description": "Writing challenges."
    },
    "/letters/{letterId}": {
      "schema": "Letter",
      "description": "Direct reader correspondence."
    },
    "/annotations/{annotationId}": {
      "schema": "Annotation",
      "description": "Prose highlights."
    },
    "/statusUpdates/{statusId}": {
      "schema": "StatusUpdate",
      "description": "Temporary visual signals."
    },
    "/questions/{questionId}": {
      "schema": "Question",
      "description": "Author inquiry nodes."
    },
    "/polls/{pollId}": {
      "schema": "Poll",
      "description": "Interactive voting nodes."
    },
    "/broadcasts/{broadcastId}": {
      "schema": "Broadcast",
      "description": "Owner transmissions."
    },
    "/feedPosts/{postId}": {
      "schema": "ThreadPost",
      "description": "Community feed entries."
    }
  }
}